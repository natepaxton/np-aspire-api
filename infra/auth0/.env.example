# Copy to .env.local (gitignored) and fill in real values.
# Values come from the `terraform` Machine to Machine app in the Auth0 dashboard (Settings tab).

# Tenant domain, without https:// (e.g. dev-xxxx.us.auth0.com)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Password for the dev-tenant test users (test-member, test-admin, test-norole)
TF_VAR_test_user_password=
